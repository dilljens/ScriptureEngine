# Scripture Engine — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# LLM API key for chat features
export DEEPSEEK_API_KEY="sk-your-key-here"

# Optional native OpenCode Go provider. Set CHAT_MODEL to the provider-prefixed
# model only after its catalog/preflight check succeeds.
# NOTE: the Go default must be a chat-completions-native model (deepseek-v4-flash).
# Muse/grok/gpt-luna/minimax/qwen families live on the /responses or /messages
# endpoints, which the worker pool does not translate — the gateway rejects them
# on /chat/completions ("Model does not support this protocol").
# export CHAT_MODEL="opencode-go/deepseek-v4-flash"
# export OPENCODE_GO_MODEL="deepseek-v4-flash"
# export OPENCODE_GO_WORKER_SOCKETS="/run/user/1000/scriptureengine-opencode-go/worker-1.sock,/run/user/1000/scriptureengine-opencode-go/worker-2.sock,/run/user/1000/scriptureengine-opencode-go/worker-3.sock,/run/user/1000/scriptureengine-opencode-go/worker-4.sock"
# For a single local account only (prefer isolated workers in production):
# export OPENCODE_API_KEY="opencode-go-key"

# ntfy.sh push notifications (optional)
# Leave unset to disable push alerts on health failure
export NTFY_TOPIC=""
export NTFY_SERVER="https://ntfy.sh"

# CORS allowed origins (comma-separated)
# Frontend dev servers that can call this API.
# NOTE: this project's Vite frontend is pinned to 5176 (5175 is held by
# axe-viewer) — keep this in sync with frontend/vite.config.js and the
# ALLOWED_ORIGINS set in web/routes/chat.py.
export CORS_ORIGINS="http://localhost:5176,http://127.0.0.1:5176,http://localhost:5175,http://localhost:5174,http://localhost:3000"

# Database path (optional — defaults to data/processed/scripture.db)
export SCRIPTURE_DB_PATH=""
export MEMORIZE_DB_PATH=""

# Server port
export PORT="5174"
